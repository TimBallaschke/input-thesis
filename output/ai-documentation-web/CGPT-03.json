{"id": "CGPT-03", "title": "AI-assisted research plan", "transcript": "ai-documentation/archive/cgpt-03-transcript.txt", "sha256": "9922393c53dccd8dbeef4f9d690678f033d9d259fdbf64f1dc3d915aee756d40", "kind": "communication_archive", "lines": [{"number": null, "text": "System", "id": "CGPT-03-H000007", "message_id": "CGPT-03-imported-L000007", "message_start": true, "message_role": "assistant", "display_only": true, "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 7, "text": "Researchplan für die Masterarbeit", "id": "CGPT-03-L000007", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 8, "text": "1. Thema in Recherchefelder aufteilen", "id": "CGPT-03-L000008", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 9, "text": "", "id": "CGPT-03-L000009", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 10, "text": "Suche nicht direkt nach deinem gesamten Thema, sondern arbeite mit einzelnen", "id": "CGPT-03-L000010", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 11, "text": "Clustern:", "id": "CGPT-03-L000011", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 12, "text": "", "id": "CGPT-03-L000012", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 13, "text": "Kommandozeile und textbasierte Interfaces", "id": "CGPT-03-L000013", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 14, "text": "GUI, Direct Manipulation und der Wechsel vom Befehl zum Zeigen", "id": "CGPT-03-L000014", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 15, "text": "Webformulare, Textfelder und Suchfelder", "id": "CGPT-03-L000015", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 16, "text": "Conversational Interfaces und Natural Language Interfaces", "id": "CGPT-03-L000016", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 17, "text": "LLM-, Prompt- und agentische Interfaces", "id": "CGPT-03-L000017", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 18, "text": "Formale Gestaltung des Text-Inputs", "id": "CGPT-03-L000018", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 19, "text": "Interface-, Medien- und Designgeschichte", "id": "CGPT-03-L000019", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 20, "text": "", "id": "CGPT-03-L000020", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 21, "text": "Lege diese Cluster direkt als Sammlungen in Zotero an.", "id": "CGPT-03-L000021", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 22, "text": "", "id": "CGPT-03-L000022", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 23, "text": "2. Die Tools und ihr richtiger Einsatz", "id": "CGPT-03-L000023", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 24, "text": "Tool    Wofür?  Richtiger Approach", "id": "CGPT-03-L000024", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 25, "text": "Google Scholar  Breiter Einstieg und erste Schlüsselquellen     Pro Cluster mit", "id": "CGPT-03-L000025", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 26, "text": "mehreren Begriffskombinationen suchen. Zuerst nach Überblickspapers, häufig", "id": "CGPT-03-L000026", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 27, "text": "zitierten Grundlagen und aktuellen Reviews suchen. Danach „Cited by“ und „Related", "id": "CGPT-03-L000027", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 28, "text": "articles“ verwenden.", "id": "CGPT-03-L000028", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 29, "text": "ACM Digital Library     HCI, Interaction Design, CLI, Conversational Interfaces,", "id": "CGPT-03-L000029", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 30, "text": "Human-AI Interaction   Präziser als bei Google Scholar suchen. Besonders", "id": "CGPT-03-L000030", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 31, "text": "Publikationen aus CHI, DIS, UIST und TOCHI prüfen. Nach Abstract, Introduction und", "id": "CGPT-03-L000031", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 32, "text": "Related Work entscheiden, ob ein Paper relevant ist.", "id": "CGPT-03-L000032", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 33, "text": "JSTOR / Project MUSE    Designgeschichte, Medientheorie, Interface-Theorie", "id": "CGPT-03-L000033", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 34, "text": "Breiter und begrifflicher suchen: etwa nach interface culture, history of", "id": "CGPT-03-L000034", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 35, "text": "interaction, language and interface. Nicht nur aktuelle Texte betrachten, sondern", "id": "CGPT-03-L000035", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 36, "text": "auch ältere theoretische Grundlagen.", "id": "CGPT-03-L000036", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 37, "text": "Scopus / Web of Science Systematische und nachvollziehbare Literaturrecherche", "id": "CGPT-03-L000037", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 38, "text": "Erst verwenden, wenn deine Begriffe klarer sind. Suchstrings, Filter und", "id": "CGPT-03-L000038", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 39, "text": "Trefferzahlen dokumentieren. Gut zur Kontrolle, ob du zentrale Autoren oder", "id": "CGPT-03-L000039", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 40, "text": "Publikationen übersehen hast.", "id": "CGPT-03-L000040", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 41, "text": "KVK / WorldCat / Bibliothekskatalog     Bücher, Monografien und Sammelbände", "id": "CGPT-03-L000041", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 42, "text": "Nach zentralen Autoren, Buchtiteln und allgemeinen Themen suchen. Bei relevanten", "id": "CGPT-03-L000042", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 43, "text": "Büchern Inhaltsverzeichnis, Register und einzelne Kapitel prüfen – nicht jedes", "id": "CGPT-03-L000043", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 44, "text": "Buch vollständig lesen.", "id": "CGPT-03-L000044", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 45, "text": "Google Books    Innerhalb von Büchern suchen    Begriffe, Namen und konkrete", "id": "CGPT-03-L000045", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 46, "text": "historische Beispiele in Büchern auffinden. Danach das Buch über Bibliothek oder", "id": "CGPT-03-L000046", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 47, "text": "Fernleihe beschaffen.", "id": "CGPT-03-L000047", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 48, "text": "ResearchRabbit / Connected Papers / Litmaps     Verwandte Literatur und", "id": "CGPT-03-L000048", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 49, "text": "Forschungsnetzwerke     Erst einsetzen, sobald du ein wirklich relevantes", "id": "CGPT-03-L000049", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 50, "text": "Ausgangspaper hast. Nicht mit einem zufälligen Paper starten. Pro Themencluster", "id": "CGPT-03-L000050", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 51, "text": "ein bis drei Schlüsselquellen als Seeds verwenden.", "id": "CGPT-03-L000051", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 52, "text": "Semantic Scholar        Schnelle Ergänzung und ähnliche Papers  Nutzen, wenn", "id": "CGPT-03-L000052", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 53, "text": "Google Scholar zu unübersichtlich wird. Besonders auf ähnliche Arbeiten,", "id": "CGPT-03-L000053", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 54, "text": "einflussreiche Zitate und neuere Folgestudien achten.", "id": "CGPT-03-L000054", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 55, "text": "Internet Archive / Computer History Museum      Historische Primärquellen", "id": "CGPT-03-L000055", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 56, "text": "Nach Handbüchern, Interface-Demonstrationen, Software, Screenshots und Oral", "id": "CGPT-03-L000056", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 57, "text": "Histories suchen. Primärquellen immer von wissenschaftlicher Sekundärliteratur", "id": "CGPT-03-L000057", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 58, "text": "einordnen lassen.", "id": "CGPT-03-L000058", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 59, "text": "W3C / WHATWG    Geschichte und Definition von Webformularen und input", "id": "CGPT-03-L000059", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 60, "text": "Verschiedene Versionen der HTML-Spezifikation vergleichen. Dokumentieren, wann", "id": "CGPT-03-L000060", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 61, "text": "Funktionen, Typen und Begriffe eingeführt oder verändert wurden.", "id": "CGPT-03-L000061", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 62, "text": "Zotero  Literaturverwaltung und Notizen Jede relevante Quelle sofort speichern,", "id": "CGPT-03-L000062", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 63, "text": "verschlagworten und einem Cluster zuordnen. Zu jeder gelesenen Quelle eine kurze", "id": "CGPT-03-L000063", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 64, "text": "eigene Zusammenfassung und Seitenzahlen wichtiger Stellen notieren.", "id": "CGPT-03-L000064", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 65, "text": "3. Konkreter Workflow", "id": "CGPT-03-L000065", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 66, "text": "Phase A: Orientierung", "id": "CGPT-03-L000066", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 67, "text": "", "id": "CGPT-03-L000067", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 68, "text": "Arbeite zunächst jeden Themencluster kurz durch.", "id": "CGPT-03-L000068", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 69, "text": "", "id": "CGPT-03-L000069", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 70, "text": "Pro Cluster:", "id": "CGPT-03-L000070", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 71, "text": "", "id": "CGPT-03-L000071", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 72, "text": "3–5 unterschiedliche Suchstrings ausprobieren", "id": "CGPT-03-L000072", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 73, "text": "2–3 Überblicksquellen finden", "id": "CGPT-03-L000073", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "assistant", "role_provenance": "editorial_annotation_of_supplied_text"}, {"number": 74, "text": "zentrale Begriffe und Autoren notieren", "id": "CGPT-03-L000074", "message_id": "CGPT-03-imported-L000007", "message_start": false, "message_role": "as